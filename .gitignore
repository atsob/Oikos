# Αγνοήστε συγκεκριμένα αρχεία
#secrets.txt
#config.py
# config/settings.py used to be ignored after an earlier version of it hardcoded
# a real password as an os.getenv() fallback. That's fixed now — it only reads
# os.getenv(name, non-secret-default) — real secrets live solely in .env
# (still ignored below), so this file is safe, and needs to be tracked to avoid
# silently drifting out of sync across machines that build the Docker image.
#settings.py

# Αγνοήστε ολόκληρους φακέλους
__pycache__/
.venv/
.vs/
#.env

# Αγνοήστε αρχεία με συγκεκριμένη κατάληξη
#*.log
#*.db
#.DS_Store
.*
# .* above blocks every dotfile including .dockerignore, which needs to be
# version-controlled since Docker builds (incl. on the deploy host) depend on it.
# Same for .env.example — the template a self-hoster copies to their own .env;
# .env itself (real secrets) stays blocked by the .* rule above, unexempted.
!.dockerignore
!.env.example
# .github/ needs to be tracked too -- FUNDING.yml (Sponsor button) lives there.
!.github/
!.github/**
ssl/
