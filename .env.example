# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Used both by local/dev runs (loaded via python-dotenv,
# see config/settings.py) and by docker-compose.yml for ${VAR} substitution.

# PostgreSQL connection
DB_USER=admin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Oikos
DB_TIMEZONE=Europe/Athens

# First login account, created automatically on first startup if the Users
# table is empty (harmless to leave set afterward — it won't recreate or
# overwrite an existing account).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Ollama (local LLM used for AI summaries) — optional, only needed if you use
# the Ollama-backed features instead of/alongside a hosted LLM.
OLLAMA_IP=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b

# EODHD market data API key — optional, get one at https://eodhd.com
EODHD_API_KEY=

# GoCardless Bank Account Data (PSD2 open banking) — optional, pre-fills the
# Importers > GoCardless tab. Leave unset to enter credentials manually per session.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Salt Edge Account Information API v5 (PSD2 open banking) — optional, pre-fills
# the Importers > Salt Edge tab. Get from https://www.saltedge.com/dashboard
SALTEDGE_APP_ID=
SALTEDGE_SECRET=

# docker-compose.yml only — where scheduled DB backups are written on the host,
# bind-mounted into the container. Defaults to ./database_backups (created
# automatically if it doesn't exist); override with an absolute path if you'd
# rather keep backups outside the repo checkout.
BACKUP_DIR=./database_backups

# docker-compose.yml only — image name `docker compose pull`/`up` looks for.
# Defaults to atsob/oikos:latest (built and pushed to Docker Hub via
# .docker_build/.docker_push). If you're building locally instead of pulling
# a pre-built image, override to your own tag (e.g. oikos:latest) and run
# `docker compose up -d --build`.
IMAGE_NAME=atsob/oikos:latest
